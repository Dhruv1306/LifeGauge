datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  passwordHash        String
  name                String
  weightTasks         Int                   @default(40)
  weightFocus         Int                   @default(35)
  weightHabits        Int                   @default(25)
  dailyFocusTargetMin Int                   @default(120)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tasks               Task[]
  habits              Habit[]
  timeEntries         TimeEntry[]
  weeklyReviews       WeeklyReview[]
  monthlyRewinds      MonthlyRewind[]
  // Google Calendar — kept strictly separate from productivity analytics
  googleCalendarToken GoogleCalendarToken?
  calendarEvents      CalendarEvent[]

  @@map("users")
}

model Task {
  id           String      @id @default(uuid())
  userId       String
  title        String
  description  String?     @db.Text
  priority     Priority    @default(MEDIUM)
  dueDate      DateTime?
  isCompleted  Boolean     @default(false)
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries  TimeEntry[]

  @@index([userId])
  @@map("tasks")
}

model Habit {
  id         String     @id @default(uuid())
  userId     String
  title      String
  targetDays String     @default("ALL") // "MON,TUE,WED,THU,FRI,SAT,SUN" or "ALL"
  startDate  String?    // "YYYY-MM-DD" - start date of habit
  order      Int        @default(0)     // display order position
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       HabitLog[]

  @@index([userId])
  @@index([userId, order])
  @@map("habits")
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  date        String   // "YYYY-MM-DD"
  isCompleted Boolean  @default(true)
  loggedAt    DateTime @default(now())

  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@map("habit_logs")
}

model TimeEntry {
  id          String   @id @default(uuid())
  userId      String
  taskId      String?
  category    String   // e.g. "DSA", "Study", "Coding", "Fitness", "General"
  description String?  @db.Text
  date        String   // "YYYY-MM-DD"
  startTime   String?  // e.g. "14:00"
  endTime     String?  // e.g. "15:30"
  durationMin Int
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@map("time_entries")
}

model WeeklyReview {
  id                String   @id @default(uuid())
  userId            String
  year              Int
  weekNumber        Int
  structuredPayload Json
  periodSummary     String   @db.Text
  observations      Json
  recommendations   Json
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, weekNumber])
  @@index([userId])
  @@map("weekly_reviews")
}

model MonthlyRewind {
  id                String   @id @default(uuid())
  userId            String
  year              Int
  month             Int
  structuredPayload Json
  highlights        Json
  storyNarrative    String   @db.Text
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
  @@map("monthly_rewinds")
}

// ============================================================
// Google Calendar Integration — STRICTLY ISOLATED
// These models must never be read by or referenced from the
// deterministic analytics engine or AI review services.
// CalendarEvent and GoogleCalendarToken are NOT TimeEntry.
// ============================================================

/// Stores the encrypted OAuth tokens and incremental sync state for a connected Google account.
/// One record per user. Deleted on disconnect (tokens revoked first).
model GoogleCalendarToken {
  id                    String    @id @default(uuid())
  userId                String    @unique
  /// AES-256-GCM encrypted refresh token (hex: iv:authTag:ciphertext)
  encryptedRefreshToken String    @db.Text
  /// Google account email shown in the UI status badge
  googleEmail           String?
  /// Google Calendar API nextSyncToken for incremental sync — null means a full sync is needed
  syncToken             String?   @db.Text
  /// Timestamp of last successful sync — used to skip redundant re-syncs
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_tokens")
}

/// Local cache of Google Calendar events. Kept completely separate from TimeEntry.
/// IMPORTANT: These events must never contribute to productivity scores, analytics,
/// Weekly Reviews, or Monthly Rewinds — this is enforced in the analytics service layer.
model CalendarEvent {
  id               String    @id @default(uuid())
  userId           String
  /// The event's unique ID in Google Calendar — used to deduplicate and sync
  googleEventId    String
  googleCalendarId String    @default("primary")
  title            String
  description      String?   @db.Text
  location         String?
  /// UTC start datetime — null for all-day events (use startDate instead)
  startTime        DateTime?
  /// UTC end datetime — null for all-day events (use endDate instead)
  endTime          DateTime?
  /// YYYY-MM-DD for all-day event start (inclusive)
  startDate        String?
  /// YYYY-MM-DD for all-day event end (exclusive, Google Calendar convention)
  endDate          String?
  isAllDay         Boolean   @default(false)
  /// True if this is an instance of a recurring event series
  isRecurring      Boolean   @default(false)
  /// Google's recurringEventId for recurring instances (links to the series master)
  recurringEventId String?
  /// confirmed | tentative | cancelled. Cancelled events are soft-deleted from cache.
  status           String    @default("confirmed")
  /// IANA timezone string (e.g. "Asia/Kolkata")
  timezone         String?
  /// Google etag for optimistic concurrency / conflict detection
  etag             String?
  /// Last time this event was written by LifeGauge to Google (used for loop prevention)
  writtenByUsAt    DateTime?
  syncedAt         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId])
  @@index([userId, startTime])
  @@index([userId, startDate])
  @@map("calendar_events")
}
