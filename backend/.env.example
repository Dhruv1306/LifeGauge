# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# JWT Secret Key (replace with a long, secure random string in production)
JWT_SECRET=lifegauge_dev_secret_key_change_in_production_2026

# Webhook Secret for External Cron Triggers
CRON_SECRET=lifegauge_cron_secret_webhook_2026

# Database Connection URL:
# For Aiven Hosted MySQL:
# DATABASE_URL="mysql://<AVN_USER>:<AVN_PASSWORD>@<AVN_HOST>:<AVN_PORT>/<AVN_DATABASE>?ssl-mode=REQUIRED"
#
# For Local MySQL (if running locally on port 3306):
# DATABASE_URL="mysql://root:password@localhost:3306/lifegauge"
DATABASE_URL="mysql://avnadmin:your_password@your_aiven_host:your_port/defaultdb?ssl-mode=REQUIRED"

# Allowed CORS Origin (Vite local dev server)
CORS_ORIGIN="http://localhost:5173"
