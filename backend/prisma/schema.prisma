datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  passwordHash        String
  name                String
  weightTasks         Int             @default(40)
  weightFocus         Int             @default(35)
  weightHabits        Int             @default(25)
  dailyFocusTargetMin Int             @default(120)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tasks               Task[]
  habits              Habit[]
  timeEntries         TimeEntry[]
  weeklyReviews       WeeklyReview[]
  monthlyRewinds      MonthlyRewind[]

  @@map("users")
}

model Task {
  id           String      @id @default(uuid())
  userId       String
  title        String
  description  String?     @db.Text
  priority     Priority    @default(MEDIUM)
  dueDate      DateTime?
  isCompleted  Boolean     @default(false)
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries  TimeEntry[]

  @@index([userId])
  @@map("tasks")
}

model Habit {
  id         String     @id @default(uuid())
  userId     String
  title      String
  targetDays String     @default("ALL") // "MON,TUE,WED,THU,FRI,SAT,SUN" or "ALL"
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       HabitLog[]

  @@index([userId])
  @@map("habits")
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  date        String   // "YYYY-MM-DD"
  isCompleted Boolean  @default(true)
  loggedAt    DateTime @default(now())

  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@map("habit_logs")
}

model TimeEntry {
  id          String   @id @default(uuid())
  userId      String
  taskId      String?
  category    String   // e.g. "DSA", "Study", "Coding", "Fitness", "General"
  description String?  @db.Text
  date        String   // "YYYY-MM-DD"
  startTime   String?  // e.g. "14:00"
  endTime     String?  // e.g. "15:30"
  durationMin Int
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@map("time_entries")
}

model WeeklyReview {
  id                String   @id @default(uuid())
  userId            String
  year              Int
  weekNumber        Int
  structuredPayload Json
  periodSummary     String   @db.Text
  observations      Json
  recommendations   Json
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, weekNumber])
  @@index([userId])
  @@map("weekly_reviews")
}

model MonthlyRewind {
  id                String   @id @default(uuid())
  userId            String
  year              Int
  month             Int
  structuredPayload Json
  highlights        Json
  storyNarrative    String   @db.Text
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
  @@map("monthly_rewinds")
}
